{
  "functions": {
    "api/edge-proxy.js": {
      "runtime": "@vercel/node@3.2.1"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/edge-proxy.js"
    },
    {
      "source": "/amap/(.*)",
      "destination": "/api/edge-proxy.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
