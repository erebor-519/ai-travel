{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Failover-Enabled",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://footmarks.world"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Failover-Enabled"
        }
      ]
    }
  ]
}